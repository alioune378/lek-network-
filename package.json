    "pg": "^8.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.8.3",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
