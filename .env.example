# Public site URL, used for canonical links and share URLs.
NEXT_PUBLIC_SITE_URL=https://leknetwork.netlify.app

# LËK Live. Leave empty: the Live page then shows "offline", never a fake stream.
# When a real broadcast exists, set an HLS (.m3u8) URL and the status.
NEXT_PUBLIC_LIVE_STATUS=offline          # offline | live | scheduled
NEXT_PUBLIC_LIVE_HLS_URL=
NEXT_PUBLIC_LIVE_TITLE=

# Future production services (not used by the prototype)
# VIDEO_PROVIDER_TOKEN=

# ---------------------------------------------------------------------------------------------
# LËK Community. TEMPLATE ONLY — never commit real values. Set them in Netlify:
# Site configuration > Environment variables, on the STAGING site only (see docs/STAGING.md).
# The public production site leaves all of these unset (community off).
# ---------------------------------------------------------------------------------------------

# Mode: off (default) | demo (CI only) | pilot (private staging) | live (after founder approval)
# COMMUNITY_MODE=pilot
# NEXT_PUBLIC_COMMUNITY_MODE=pilot

# Registration: closed (default) | invite | open. "open" is ignored unless COMMUNITY_MODE=live AND
# COMMUNITY_OPEN_APPROVED=approved-by-founder-YYYY-MM-DD is set by the founder.
# COMMUNITY_REGISTRATION=invite
# NEXT_PUBLIC_COMMUNITY_REGISTRATION=invite
# COMMUNITY_OPEN_APPROVED=

# Staging marker: noindex headers, robots.txt disallow, visible badge.
# LEK_ENV=staging
# NEXT_PUBLIC_LEK_ENV=staging
# NEXT_PUBLIC_PILOT_END_DATE=2026-12-15

# Public URL of the site running the community (no trailing slash).
# BETTER_AUTH_URL=https://leknetwork-staging.netlify.app
# COMMUNITY_TRUSTED_ORIGINS=

# Database. Netlify Database injects NETLIFY_DB_URL automatically; DATABASE_URL overrides it.
# DATABASE_URL=
# DB_POOL_MAX=3

# SECRET — 32+ random characters (e.g. `openssl rand -hex 32`). Mark as secret in Netlify.
# BETTER_AUTH_SECRET=

# SECRET — founder bootstrap. 32+ random characters, used once at /fr/admin/bootstrap.
# BOOTSTRAP_TOKEN=
# FOUNDER_EMAIL=

# SECRET — Resend (transactional email) API key, and a sender on a domain verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM=LËK Community <communaute@mail.example-domain.sn>

# SECRET — Cloudflare Turnstile secret key; the site key is public.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# CI ONLY — never on a Netlify site (the build refuses them there).
# MAIL_CAPTURE=1
# TEST_MAIL_TOKEN=
