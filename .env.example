# Public site URL, used for canonical links and share URLs.
NEXT_PUBLIC_SITE_URL=https://leknetwork.netlify.app

# LËK Live. Leave empty: the Live page then shows "offline", never a fake stream.
# When a real broadcast exists, set an HLS (.m3u8) URL and the status.
NEXT_PUBLIC_LIVE_STATUS=offline          # offline | live | scheduled
NEXT_PUBLIC_LIVE_HLS_URL=
NEXT_PUBLIC_LIVE_TITLE=

# Future production services (not used by the prototype)
# DATABASE_URL=
# AUTH_SECRET=
# VIDEO_PROVIDER_TOKEN=
